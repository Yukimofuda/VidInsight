# VidInsight Day 2 (macOS-safe baseline)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
VIDINSIGHT_API_URL=http://127.0.0.1:8000
VIDINSIGHT_WORKER_POLL_SECONDS=1.5
# Optional custom DB path. Default: storage/sqlite/vidinsight.db
# VIDINSIGHT_DB_PATH=/absolute/path/to/vidinsight.db

# Day 3 retrieval starter (lazy-loaded; does not block Day 2 ASR)
VIDINSIGHT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
